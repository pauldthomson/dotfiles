# Powerlevel10k instant prompt must precede initialization that prints output.
# Anything that needs console input must go above this block.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Resolve this file's symlink so completions work wherever the checkout lives.
dotfiles_root="${${(%):-%x}:A:h:h}"

# Keep PATH entries unique, including when this file is sourced again.
typeset -U PATH path

# Vi keybindings; allow backspace after returning to insert mode.
bindkey -v
bindkey '^?' backward-delete-char

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k"
DISABLE_AUTO_UPDATE="true"
ENABLE_CORRECTION="true"
COMPLETION_WAITING_DOTS="true"

plugins=(
    zsh-autosuggestions
    # Keep this before fzf for vim keybindings.
    vi-mode
    fzf
    git
    httpie
    jj
    # Used by the custom JJ prompt in p10k.zsh.
    async
    nvm
)

# Stable completion cache; Oh My Zsh runs compinit.
ZSH_COMPDUMP="${XDG_CACHE_HOME:-$HOME/.cache}/oh-my-zsh/.zcompdump-${ZSH_VERSION}"
mkdir -p "${ZSH_COMPDUMP:h}"

# Lazy-load nvm on first Node tool usage; Pi uses Homebrew's Node installation.
zstyle ':omz:plugins:nvm' lazy yes
source "$ZSH/oh-my-zsh.sh"

export EDITOR="nvim"
export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export EZA_CONFIG_DIR="$HOME/.config/eza"

alias c=corectl
alias ls='ls -G'
alias grep='grep --colour=auto'
alias fgrep='fgrep --colour=auto'
alias egrep='egrep --colour=auto'
alias ll='eza --icons -la'
alias la='ls -A'
alias l='ls -CF'
alias p='ptmux'
alias prx='prex'
alias cat=bat
alias rg='rg --smart-case'
alias k='kubectl'
alias kgy='kubectl get -o yaml'
alias go='nocorrect go'
alias lg='lazygit'
alias gsp='gcloud-set-project'

export FZF_DEFAULT_COMMAND='rg --no-ignore --files --hidden --follow --glob "!.git/*"'
export PATH="$PATH:$HOME/go/bin"
export PATH="${KREW_ROOT:-$HOME/.krew}/bin:$PATH"
export PATH="/Applications/IntelliJ IDEA.app/Contents/MacOS:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# ptmux uses Bash completion; prex uses native Zsh completion.
if [[ -f "$dotfiles_root/ptmux_completion" ]]; then
  autoload -U +X bashcompinit && bashcompinit
  source "$dotfiles_root/ptmux_completion"
fi
[[ ! -f "$dotfiles_root/prex/completion.zsh" ]] || source "$dotfiles_root/prex/completion.zsh"

# Terminal pinentry for GPG signing.
if [[ -t 0 ]]; then
  export GPG_TTY="$(tty)"
fi

# Private Go modules.
export GOPRIVATE="github.com/tyro-private"

if command -v kubectl >/dev/null 2>&1; then
  KUBECTL_COMPLETION_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/zsh/kubectl-completion.zsh"
  if [[ ! -s "$KUBECTL_COMPLETION_CACHE" ]]; then
    mkdir -p "${KUBECTL_COMPLETION_CACHE:h}"
    kubectl completion zsh >| "$KUBECTL_COMPLETION_CACHE" 2>/dev/null
  fi
  [[ -s "$KUBECTL_COMPLETION_CACHE" ]] && source "$KUBECTL_COMPLETION_CACHE"
fi

# Java (Homebrew) - keep JAVA_HOME on newest installed JDK.
if [[ -x /usr/libexec/java_home ]]; then
  JAVA_HOME="$(/usr/libexec/java_home 2>/dev/null)"
fi

if [[ -z "$JAVA_HOME" ]]; then
  if command -v brew >/dev/null 2>&1; then
    brew_prefix="${HOMEBREW_PREFIX:-$(brew --prefix)}"
    if [[ -d "$brew_prefix/opt/openjdk" ]]; then
      JAVA_HOME="$brew_prefix/opt/openjdk"
    else
      latest_jdk="$(print -l "$brew_prefix"/opt/openjdk@*(N) | sort -t@ -k2,2n | tail -n 1)"
      if [[ -n "$latest_jdk" ]]; then
        JAVA_HOME="$latest_jdk"
      fi
    fi
  fi
fi

if [[ -n "$JAVA_HOME" ]]; then
  export JAVA_HOME
  export PATH="$JAVA_HOME/bin:$PATH"
fi

# Corporate proxy CA trust for Python and Node.
if [[ -f /Library/Certificates/allcerts.pem ]]; then
  export REQUESTS_CA_BUNDLE=/Library/Certificates/allcerts.pem
  export NODE_EXTRA_CA_CERTS=/Library/Certificates/allcerts.pem
fi

if command -v brew >/dev/null 2>&1; then
  brew_prefix="${HOMEBREW_PREFIX:-$(brew --prefix)}"
  [[ ! -f "$brew_prefix/share/google-cloud-sdk/path.zsh.inc" ]] || source "$brew_prefix/share/google-cloud-sdk/path.zsh.inc"
  [[ ! -f "$brew_prefix/share/google-cloud-sdk/completion.zsh.inc" ]] || source "$brew_prefix/share/google-cloud-sdk/completion.zsh.inc"
fi

export BUN_INSTALL="$HOME/.bun"
[[ ! -d "$BUN_INSTALL/bin" ]] || export PATH="$BUN_INSTALL/bin:$PATH"
[[ ! -s "$BUN_INSTALL/_bun" ]] || source "$BUN_INSTALL/_bun"

# To customize the prompt, run `p10k configure` or edit zsh/p10k.zsh.
[[ ! -f "$dotfiles_root/zsh/p10k.zsh" ]] || source "$dotfiles_root/zsh/p10k.zsh"
unset dotfiles_root

# Load last so highlighting wraps widgets installed by plugins/completions.
if [[ -f /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /opt/homebrew/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
elif [[ -f /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ]]; then
  source /usr/local/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
fi
