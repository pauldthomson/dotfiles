#!/bin/bash
# Launcher for project checkouts in Herdr. Cleanup requires an explicit path confirmation.
set -Eeuo pipefail
herdr_bin=${HERDR_BIN_PATH:-herdr}
repos="$HOME/repos"
created_workspace_id=''
error_log="$HOME/.config/herdr/workspace-launcher.log"

report_failure() {
  local status=$1 message=$2
  trap - ERR
  if [ -n "$created_workspace_id" ]; then
    "$herdr_bin" workspace close "$created_workspace_id" >/dev/null 2>&1 || true
  fi
  printf 'project-workspace: %s\n' "$message" >&2
  printf 'Details: %s\n' "$error_log" >&2
  if [ -t 0 ]; then
    printf 'Press Enter to close this popup. ' >&2
    IFS= read -r _ || true
  fi
  exit "$status"
}
fail() { report_failure 1 "$*"; }
# Preserve command errors after the popup closes, and keep interactive failures visible.
mkdir -p "${error_log%/*}"
exec 2> >(tee -a "$error_log" >&2)
trap 'report_failure "$?" "command failed: $BASH_COMMAND"' ERR
# Resolve the root even when a pane has cd'd into a subdirectory.
root_for() { jj -R "$1" root 2>/dev/null; }
# JJ omits the canonical workspace root from `jj workspace list` on some repos.
# A linked checkout's .jj/repo file points directly to the canonical .jj/repo.
canonical_for() {
  local project=$1 link repo_dir origin
  [ -f "$project/.jj/repo" ] || return 1
  link=$(<"$project/.jj/repo")
  case "$link" in
    /*) repo_dir=$(realpath "$link") || return 1 ;;
    *) repo_dir=$(realpath "$project/.jj/$link") || return 1 ;;
  esac
  [ "${repo_dir##*/}" = repo ] || return 1
  origin=$(dirname "$(dirname "$repo_dir")")
  [ -d "$origin/.jj/repo" ] || return 1
  printf '%s\n' "$origin"
}
# A workspace has no cwd of its own in Herdr; its initial pane retains the launcher cwd.
workspace_root() {
  local cwd
  cwd=$("$herdr_bin" pane list --workspace "$1" |
    jq -er '.result.panes[0].cwd') || return 1
  root_for "$cwd" || printf '%s\n' "$cwd"
}
checkout_clean() {
  # JJ's working-copy commit can be dirty even when the filesystem has no
  # unsnapshotted changes. Also reject unresolved conflicts.
  [ "$(jj -R "$1" log -r @ --no-graph -T 'if(empty && !conflict, "clean", "dirty")')" = clean ]
}
used_by_other_herdr_workspace() {
  local id path
  while IFS= read -r id; do
    [ "$id" != "${1:-}" ] || continue
    path=$(workspace_root "$id") || continue
    [ "$path" != "$2" ] || return 0
  done < <("$herdr_bin" workspace list | jq -r '.result.workspaces[].workspace_id')
  return 1
}
launch() {
  local project=$1 label=$2 workspace workspace_id nvim_tab_id nvim_pane_id agent agent_pane_id
  workspace=$("$herdr_bin" workspace create --cwd "$project" --label "$label" --no-focus)
  workspace_id=$(jq -er '.result.workspace.workspace_id' <<<"$workspace")
  nvim_tab_id=$(jq -er '.result.tab.tab_id' <<<"$workspace")
  nvim_pane_id=$(jq -er '.result.root_pane.pane_id' <<<"$workspace")
  # On failure close only the Herdr workspace made by this invocation; keep the checkout.
  created_workspace_id=$workspace_id
  "$herdr_bin" tab rename "$nvim_tab_id" nvim >/dev/null
  "$herdr_bin" pane run "$nvim_pane_id" nvim >/dev/null
  agent=$("$herdr_bin" tab create --workspace "$workspace_id" --cwd "$project" --label agent --no-focus)
  agent_pane_id=$(jq -er '.result.root_pane.pane_id' <<<"$agent")
  "$herdr_bin" pane run "$agent_pane_id" pi >/dev/null
  "$herdr_bin" tab create --workspace "$workspace_id" --cwd "$project" --label scratch --no-focus >/dev/null
  "$herdr_bin" workspace focus "$workspace_id" >/dev/null
  "$herdr_bin" tab focus "$nvim_tab_id" >/dev/null
  created_workspace_id=''
}
open_project() {
  local selected project path id existing=0 suffix name
  [ -d "$repos" ] || exit 0
  selected=$(cd "$repos" && find . -mindepth 3 -maxdepth 3 -type d -print |
    while IFS= read -r dir; do
      [ -d "$dir/.git" ] || [ -d "$dir/.jj/repo" ] || continue
      printf '%s\n' "${dir#./}"
    done | sort | fzf --prompt='project> ') || exit 0
  [ -n "$selected" ] || exit 0
  project="$repos/$selected"
  # Compare actual JJ roots, not labels (different repositories may share a name).
  if [ -d "$project/.jj/repo" ]; then
    while IFS= read -r id; do
      path=$(workspace_root "$id") || continue
      if [ "$path" = "$project" ] || jj -R "$project" workspace list -T 'root ++ "\n"' | grep -Fxq "$path"; then
        existing=1
        break
      fi
    done < <("$herdr_bin" workspace list | jq -r '.result.workspaces[].workspace_id')
  fi
  if [ "$existing" -eq 1 ]; then
    printf 'Checkout name (letters, numbers, hyphens): '
    IFS= read -r suffix || exit 0
    # Accept a suffix written with its separator, e.g. -evals or evals.
    suffix=${suffix#-}
    [[ "$suffix" =~ ^[a-zA-Z0-9][a-zA-Z0-9-]*$ ]] || fail 'invalid checkout name (use letters, numbers, and hyphens)'
    name="${project##*/}-$suffix"
    path="${project%/*}/$name"
    [ ! -e "$path" ] || fail "already exists: $path"
    if jj -R "$project" bookmark list -T 'name ++ "\n"' | grep -Fxq master; then
      jj -R "$project" workspace add "$path" --name "$name" -r master
    else
      jj -R "$project" workspace add "$path" --name "$name"
    fi
    launch "$path" "${project##*/} · $suffix"
  else
    launch "$project" "${project##*/}"
  fi
}
close_project() {
  local id=${HERDR_ACTIVE_WORKSPACE_ID:-} project origin='' name choice
  [ -n "$id" ] || fail 'no active Herdr workspace'
  project=$(workspace_root "$id") || fail 'cannot determine workspace path'
  # The canonical checkout owns .jj/repo; secondary workspaces have a .jj pointer.
  if [ -d "$project/.jj/repo" ] || [ ! -e "$project/.jj" ]; then
    "$herdr_bin" workspace close "$id" >/dev/null
    return
  fi
  origin=$(canonical_for "$project") || origin=''
  name=$(jj -R "$project" workspace list -T 'name ++ "\t" ++ root ++ "\n"' |
    awk -F '\t' -v root="$project" '$2 == root {print $1}')
  [ -n "$name" ] || fail 'cannot identify JJ workspace; refusing to close'
  if used_by_other_herdr_workspace "$id" "$project"; then
    "$herdr_bin" workspace close "$id" >/dev/null
    printf 'Checkout is still open in another Herdr workspace; keeping %s\n' "$project"
    return
  fi
  # Never delete an arbitrary checkout outside the canonical checkout's parent.
  if [ -z "$origin" ] || [ "${origin%/*}" != "${project%/*}" ]; then
    "$herdr_bin" workspace close "$id" >/dev/null
    printf 'Keeping %s (no safe canonical sibling found)\n' "$project"
    return
  fi
  if checkout_clean "$project"; then
    choice=$(printf 'Keep checkout\nDelete checkout and forget JJ workspace\n' |
      fzf --prompt="Close $name; cleanup? > " --no-sort) || return 0
  else
    choice=$(printf 'Keep checkout (dirty; deletion disabled)\n' |
      fzf --prompt="Close $name; JJ working copy is dirty > " --no-sort) || return 0
  fi
  if [ "$choice" != 'Delete checkout and forget JJ workspace' ]; then
    "$herdr_bin" workspace close "$id" >/dev/null
    return
  fi
  # Check again after the choice in case the agent was editing in parallel.
  if ! checkout_clean "$project"; then
    printf 'JJ working copy changed; keeping %s\n' "$project"
    jj -R "$project" status
    return 1
  fi
  # Closing the current workspace kills its popup. Detach the close + cleanup so
  # the process survives that close; never delete until Herdr reports success.
  python3 - "$0" "$origin" "$project" "$name" "$id" <<'PY'
import os, subprocess, sys
log = open(os.path.expanduser('~/.config/herdr/workspace-cleanup.log'), 'a')
subprocess.Popen(['bash', *sys.argv[1:2], 'cleanup', *sys.argv[2:]],
                 stdin=subprocess.DEVNULL, stdout=log, stderr=log,
                 start_new_session=True)
PY
  printf 'Closing %s; cleanup results: ~/.config/herdr/workspace-cleanup.log\n' "$name"
}
cleanup() {
  local origin=$1 project=$2 name=$3 id=$4 root
  # Recheck before deletion, even if the user switched workspaces after confirming.
  [ -d "$origin/.jj/repo" ] && [ "${origin%/*}" = "${project%/*}" ] &&
    [ -d "$project/.jj" ] && [[ "$name" = "${project##*/}" ]] ||
    fail 'unsafe checkout; refusing deletion'
  root=$(jj -R "$project" root)
  [ "$root" = "$project" ] && [ "$(canonical_for "$project")" = "$origin" ] &&
    jj -R "$origin" workspace list -T 'name ++ "\t" ++ root ++ "\n"' |
      grep -Fxq "$(printf '%s\t%s' "$name" "$project")" ||
    fail 'JJ workspace mapping changed; refusing deletion'
  used_by_other_herdr_workspace "$id" "$project" && fail 'checkout still in use'
  checkout_clean "$project" || fail 'JJ working copy is dirty; leaving workspace open'
  "$herdr_bin" workspace close "$id" >/dev/null
  checkout_clean "$project" || fail 'JJ working copy became dirty; keeping checkout'
  jj -R "$origin" workspace forget "$name"
  rm -rf -- "$project"
  printf 'Removed %s\n' "$project"
}
case "${1:-}" in
  open) open_project ;;
  close) close_project ;;
  cleanup) shift; cleanup "$@" ;;
  *) fail 'usage: project-workspace open|close' ;;
esac
